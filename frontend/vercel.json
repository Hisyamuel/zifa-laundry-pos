{
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "https://zifa-laundry-pos.onrender.com/api/$1"
        },
        {
            "source": "/",
            "destination": "/frontend/index.html"
        },
        {
            "source": "/:file.html",
            "destination": "/pages/:file.html"
        }
    ],
    "headers": [
        {
            "source": "/",
            "headers": [
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                }
            ]
        }
    ]
}